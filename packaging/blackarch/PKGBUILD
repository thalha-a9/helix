# This file is part of BlackArch Linux ( https://www.blackarch.org/ ).
# See COPYING for license details.

pkgname=helix-osint
_pypi_name=helix-osint
_pypi_archive=helix_osint
pkgver=3.5.0
pkgrel=1
pkgdesc='OSINT identity mapper: finds a username across 8,000+ sites, verifies every hit live and graphs how the accounts connect.'
groups=('blackarch' 'blackarch-social' 'blackarch-recon')
arch=('any')
url='https://github.com/thalha-a9/helix'
license=('MIT')
depends=('python' 'python-aiohttp')
optdepends=('python-aiohttp-socks: --tor and socks5:// proxies'
            'python-curl-cffi: TLS impersonation for X, Instagram, TikTok'
            'python-imagehash: perceptual avatar matching (--phash)'
            'python-pillow: perceptual avatar matching (--phash)'
            'holehe: deep email scan (--holehe)'
            'python-weasyprint: PDF reports (--report)')
makedepends=('python-build' 'python-pip' 'python-setuptools')
checkdepends=('python-pytest' 'python-pytest-asyncio' 'python-aiohttp-socks')
source=("https://files.pythonhosted.org/packages/source/${_pypi_name::1}/$_pypi_name/$_pypi_archive-$pkgver.tar.gz")
# Filled in by `updpkgsums` once v3.5.0 is on PyPI (see docs/RELEASING.md).
sha512sums=('SKIP')

build() {
  cd "$_pypi_archive-$pkgver"

  python -m build --wheel --no-isolation --outdir="$srcdir/dist"
}

check() {
  cd "$_pypi_archive-$pkgver"

  # Offline: the suite never touches the network.
  python -m pytest -q -p no:cacheprovider
}

package() {
  cd "$_pypi_archive-$pkgver"

  pip install \
    --verbose \
    --disable-pip-version-check \
    --no-warn-script-location \
    --ignore-installed \
    --no-compile \
    --no-deps \
    --root="$pkgdir" \
    --prefix=/usr \
    --no-index \
    --find-links="file://$srcdir/dist" \
    $_pypi_name

  # /usr/bin/helix belongs to the Helix text editor (extra/helix).
  rm -f "$pkgdir/usr/bin/helix"

  install -Dm 644 -t "$pkgdir/usr/share/doc/$pkgname/" README.md CHANGELOG.md
  install -Dm 644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
